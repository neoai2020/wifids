## App URL (fallback when request origin is unavailable; auth links use whichever domain the user is on)
NEXT_PUBLIC_SITE_URL=https://wificodemembers.com

## Support (Freshdesk inbox shown in the app and used for ticket routing)
SUPPORT_EMAIL=WifiDigitalSystem@neoai.freshdesk.com
NEXT_PUBLIC_SUPPORT_EMAIL=WifiDigitalSystem@neoai.freshdesk.com

## Optional — force-show specialist popup for QA: /embed/specialist-popup?preview=<secret>
# NEXT_PUBLIC_SPECIALIST_POPUP_PREVIEW_SECRET=your-secret-here

## Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Supabase service role (required for admin panel + open tracking)
SUPABASE_SERVICE_ROLE_KEY=

## Admin panel (Promo Links). Seeded on /auth/login via /api/auth/ensure-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

## YouTube Data API (recommended — reliable Shorts search + validation)
YOUTUBE_API_KEY=

## RapidAPI (AI comments + YouTube video search)
RAPIDAPI_KEY=
RAPIDAPI_HOST=chatgpt-42.p.rapidapi.com

## Scraper API (optional)
SCRAPER_API_KEY=
